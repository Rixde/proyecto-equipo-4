# Copiar a .env (que NUNCA se sube a git) y completar con el valor real.
FALCO_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REEMPLAZAR/CON/TU_WEBHOOK

# Opcional. Descomenta y ajusta SOLO si el usuario del sistema operativo con
# el que corres estos scripts no es el mismo con el que se provisionó el
# clúster (ej. Ansible usó "ansible" y tú corres esto como "root" u otro
# usuario). Si no lo defines, kubectl/helm usan el default de tu usuario
# (~/.kube/config).
# KUBECONFIG=/home/ansible/.kube/config
